;;=============================================================================
;; LS Tool — context collection
;;
;; PURPOSE
;;   Tally's built-in ODBC tables cannot say WHICH loaded company is the active
;;   one ($IsActive/$IsSelected/$IsCurrent all return NULL, and the Company
;;   table always lists every loaded company). This publishes that missing fact
;;   as an ODBC-visible table so LS Tool can show it before extraction.
;;
;; READ-ONLY. Defines collections only — no menus, no reports, no data changes.
;;
;; INSTALL
;;   Add this line to tally.ini (beside the existing TDL= lines), then restart
;;   Tally:
;;     TDL=<install folder>\tally_tdl\LSToolContext.tdl
;;
;; THREE VARIANTS on purpose — we test which one Tally actually populates over
;; ODBC, then keep the winner and delete the rest.
;;=============================================================================

;; --- Variant A: every loaded company, each row tagged with the CURRENT one ---
;; If ##SVCURRENTCOMPANY resolves in an ODBC session, LSCompany holds the active
;; company name on every row — read row 0 and we are done.
[Collection: LSToolCtxA]
    Type        : Company
    Fetch       : Name, StartingFrom, EndingAt
    Compute     : LSCompany   : ##SVCURRENTCOMPANY
    Compute     : LSFromDate  : ##SVFROMDATE
    Compute     : LSToDate    : ##SVTODATE

;; --- Variant B: filtered to the current company — should yield ONE row ---
[Collection: LSToolCtxB]
    Type        : Company
    Filter      : LSIsCurrentCmp
    Fetch       : Name, StartingFrom, EndingAt
    Compute     : LSCompany   : ##SVCURRENTCOMPANY
    Compute     : LSFromDate  : ##SVFROMDATE
    Compute     : LSToDate    : ##SVTODATE

;; --- Variant C: function-based, avoids the SV variables entirely ---
;; $$CurrentCompany / $$CmpName are evaluated in the request's own context, so
;; this can work even when ##SVCURRENTCOMPANY is empty over ODBC.
[Collection: LSToolCtxC]
    Type        : Company
    Fetch       : Name
    Compute     : LSCompany   : $$CurrentCompany
    Compute     : LSCmpName   : $$CmpName
    Compute     : LSFromDate  : $$FromDate
    Compute     : LSToDate    : $$ToDate

[System: Formula]
    LSIsCurrentCmp : $Name = ##SVCURRENTCOMPANY
